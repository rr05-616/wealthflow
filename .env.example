# Set independent Neon/PostgreSQL URLs for each bounded context. For a local demo,
# a single URL may be used by setting DATABASE_URL instead.
AUTH_DATABASE_URL=
USAGE_DATABASE_URL=
RATE_DATABASE_URL=
CHARGEBACK_DATABASE_URL=
WORKFLOW_DATABASE_URL=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DEMO_LAB_EMAIL=lab@example.test
DEMO_LAB_PASSWORD=replace-me
DEMO_OFFICER_EMAIL=billing@example.test
DEMO_OFFICER_PASSWORD=replace-me
# Kafka is a separate long-running service and workflow worker.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=soa.s08.t24.events
